{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "yorkle",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": { "enabled": true },
	// The built app (vite build → dist). Unknown paths get index.html so client routes load;
	// /api/* and the emailed /verify link go to the Worker, which forwards them to blingo.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/verify"]
	},
	"services": [{ "binding": "BLINGO", "service": "blingo" }]
}
