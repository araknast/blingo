{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "yorkle",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": { "enabled": true },
	// Static UI; any path that isn't a file goes to the Worker, which forwards it to blingo.
	"assets": { "directory": "./public" },
	"services": [{ "binding": "BLINGO", "service": "blingo" }]
}
