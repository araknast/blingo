{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte", "vite/client"]
	},
	"include": ["**/*.ts", "**/*.svelte"]
}
