{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "blingo",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": { "MODEL": "claude-opus-5-5", "ADMIN_USERNAME": "araknast", "EMAIL_FROM": "noreply@blingo.breakdance.cc", "DOMAIN": "blingo.breakdance.cc" },
	// Verification mail; the sender domain must be onboarded to Cloudflare Email Sending.
	"send_email": [{ "name": "EMAIL" }],
	// BLINGO_TOKEN guards the API (it mints git tokens); ANTHROPIC_API_KEY never enters the sandbox.
	"secrets": { "required": ["BLINGO_TOKEN", "ANTHROPIC_API_KEY"] },
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "blingo" }],
	"containers": [
		{
			"class_name": "Box",
			"scheduling_policy": "durable_object",
			"images": { "box": { "dockerfile": "./Dockerfile" } }
		}
	],
	"durable_objects": {
		"bindings": [
			{ "class_name": "RepoDO", "name": "REPO" },
			{ "class_name": "Box", "name": "BOX" },
			{ "class_name": "UsersDO", "name": "USERS" },
			{ "class_name": "Reviewer", "name": "REVIEWER" }
		]
	},
	"exports": {
		"RepoDO": { "type": "durable-object", "storage": "sqlite" },
		"Box": { "type": "durable-object", "storage": "sqlite" },
		"UsersDO": { "type": "durable-object", "storage": "sqlite" },
		"Reviewer": { "type": "durable-object", "storage": "sqlite" }
	}
}
